{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "rolandverner/guardian",
    "description": "Suspicion-scoring trust & moderation engine for Laravel. Pluggable detectors accrue suspicion points; thresholds flag, restrict, queue for review, or ban.",
    "keywords": [
        "laravel",
        "anti-cheat",
        "anticheat",
        "fraud",
        "moderation",
        "trust",
        "reputation",
        "ban"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Roland Verner"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "laravel/pint": "^1.29",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Guardian\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Guardian\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "pint",
        "lint:test": "pint --test",
        "stan": "phpstan analyse",
        "baseline": "phpstan analyse --generate-baseline --allow-empty-baseline",
        "check": [
            "@lint:test",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Guardian\\GuardianServiceProvider"
            ],
            "aliases": {
                "Guardian": "Guardian\\Facades\\Guardian"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
